{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @my-app/ui typegen && astro dev --port 3000",
    "build": "pnpm run typecheck && astro build",
    "preview": "pnpm run build && wrangler dev --port 3000",
    "typecheck": "pnpm --filter @my-app/ui typegen && astro check && pnpm run typecheck:worker",
    "typecheck:worker": "wrangler types && tsc --noEmit -p worker",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "storybook": "storybook dev -p 6010",
    "ci-storybook": "storybook dev -p 6010 --quiet --ci",
    "build-storybook": "storybook build",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@my-app/ui": "workspace:*",
    "astro": "7.4.4",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-mcp": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.156.0"
  }
}
