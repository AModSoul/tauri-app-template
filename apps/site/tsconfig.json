{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // `.astro/types.d.ts` is written by Astro (astro check, dev and build).
  "include": [
    ".astro/types.d.ts",
    "src",
    ".storybook",
    "astro.config.ts",
    "vitest.config.ts",
    "vitest.shims.d.ts"
  ],
  "exclude": ["dist", "worker"]
}
