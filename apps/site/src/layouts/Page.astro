---
// Every page's frame: its <head> (title, description, social cards, icons) and the header and
// footer around its content.
import { Footer, Header } from "@/islands";
import { link } from "@/links";
import { APP_NAME, DESCRIPTION, type SitePath } from "@/site-config";

interface Props {
  /** The page's own title, before the site's name; the site's name alone when there's none. */
  title?: string;
  description?: string;
  /** The page, for the navigation to mark. */
  current?: SitePath;
  /** Whether search engines should list the page at its address: not the 404 page's. */
  indexed?: boolean;
}

const { title, description = DESCRIPTION, current, indexed = true } = Astro.props;
const fullTitle = title ? `${title} · ${APP_NAME}` : APP_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(link("/icon-512.png"), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {indexed ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" sizes="32x32" href={link("/favicon-32x32.png")} />
    <link rel="apple-touch-icon" href={link("/apple-touch-icon.png")} />
    <link rel="sitemap" href={link("/sitemap-index.xml")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={APP_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <div class="page">
      <Header client:load current={current} />
      <main><slot /></main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }
  main {
    flex: 1;
  }
</style>
